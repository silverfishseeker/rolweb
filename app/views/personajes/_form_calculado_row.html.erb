<%# _form_calculado_row.html.erb %>
<td> <!-- PASSIVE MOD -->
  <input type="number"
        name="calculados[<%= index %>][passive_mod]"
        value="<%= error_coalesce{calc.modificable.passive_mod} || 0%>">
</td>
<td> <!-- ACTIVE MOD -->
  <input type="number"
        name="calculados[<%= index %>][active_mod]"
        value="<%= error_coalesce{calc.modificable.active_mod} || 0 %>">
</td>
<td> <!-- VALOR CALCULADO -->
  <%= error_coalesce{calc.value} || "ninguno" %>
</td>
<%= yield%>
<td> <!-- BORRAR -->
  <input type="checkbox"
        name="calculados[<%= index %>][_destroy]"
        value="1"
        <%= "checked" if !calc.present? %>>
</td>