<%= form_with model: x do |f| %>
  <div>
    <%= f.label :nombre, style: "display: block" %>
    <%= f.text_field :nombre %>
  </div>
  <br>
  <div class="pj-modal_checkbox_list">
    <%= f.collection_check_boxes :personajes_ids, x.personajes, :id, :nombre do |pj| %>
      <div>
        <%= pj.check_box %>
        <%= pj.label %>
      </div>
    <% end %>
  </div>
  <br>
  <div>
    <%= f.submit "Guardar", class: "btn btn-primary" %>
  </div>
<% end %>
