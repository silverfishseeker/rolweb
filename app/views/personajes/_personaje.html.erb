<div class="carta carta_personaje">
  <div class="carta-personaje-header">
    <h2><%= link_to personaje.nombre, personaje %></h2>
    <b> Nivel <%= personaje.nivel %></b>
  </div>

  <div class="carta-personaje-body">
    <div class="miniListadoClases">
      <% personaje.personajeHasClases.each do | perClase|%>
        <%= link_to perClase.clase, class:"carta-title" do %>
          <strong><%=perClase.nivel%></strong> <%=perClase.clase.nombre%>
        <% end %> <br>
      <% end %>
    </div>

    <div class="carta-image">
      <%= render "shared/image", image: personaje.picture&.image %>
    </div>
  </div>

  <div class="carta-personaje-stats">
    <% stats = personaje.estadistics.ordered.to_a %>
    <% stats.each_with_index  do |stat, i| %>
      <div class="carta-number <%= "first_number" if i == 0 %> <%= "last_number" if i == stats.length - 1 %>">
        <%=stat.tipoEstadistic.siglas%> <%=stat.value%>
      </div>
    <% end %>
  </div>
</div>
