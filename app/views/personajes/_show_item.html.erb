<%# expected params: phi, isInInventario %>

<% item = phi.item %>
<% prefix = isInInventario ? "phi_iinv" : "phi" %>
<% js_base_id = "#{prefix}-#{phi.id}" %>
<div class="carta carta_show inventario-item" id="<%= js_base_id %>"
    data-categs="<%= item.categs.map(&:id).join(",") if item %>"
    data-item-id="<%= item&.id %>">
  <div class="carta-header carta-header-small">
      <%= render "personajes/show_position_controller",
          position: phi.position,
          input_prefix: "#{prefix}[#{phi.id}]",
          id_prefix: "#{prefix}-#{phi.id}"
      %>
      <span class="carta-number">
        <input type="number" name="<%= prefix %>[<%=phi.id%>][cantidad]"
            value="<%= phi.cantidad %>" class="pj-cantidad" id="<%=js_base_id%>-cantidad">
      </span>

      <span data-label="Equipar">
        <input type="<%= isInInventario ? 'checkbox' : 'hidden' %>" name="<%= prefix %>[<%=phi.id%>][isEquipped]"
              value="1" <%= "checked" if !isInInventario || phi.isEquipped %>>
      </span>

      <% if item %>
        <% if isInInventario %>
          <p class="carta-number carta-peso">
            <%= item.peso %>
          </p>
        <% end %>

        <%= link_to item.nombre, item, class:"carta-title" %>

        <%# Los ítems aún no están migrados al autoguardado (pendiente junto con cantidad/equipar/eliminar/posición).
            "personajes/show_contadores" ahora asume autoguardado (rutas update_contador_base/rango sin
            comprobar el dueño para ítems), así que de momento se deja comentado para no romper nada. %>
        <%# render "personajes/show_contadores", calculados: phi.calculados, prefix: "#{prefix}[#{phi.id}]" %>
      <% else %>
        <input type="text" class="carta-customitem" name="<%= prefix %>[<%=phi.id%>][customitem]" value="<%=phi.customitem.nombre%>">
      <% end %>
      <span data-label="Borrar" style="margin-left: auto;">
        <span class="btn btn-small btn-danger item-eliminar-btn" id="<%=js_base_id%>-eliminar"
            onclick="
                const seq = nextItemSeq('<%= phi.id %>');
                setItemCardStateToBoth(this.closest('.carta'), true);
                fetch('<%= update_field_personaje_path(phi.personaje, field: 'item_eliminar', target_id: phi.id) %>?seq=' + seq)
                ">
          Eliminar
        </span>
        <span class="btn btn-small btn-secondary pj-fila_borrada-restaurar_btn btn-no_tachado" hidden id="<%=js_base_id%>-restaurar"
            onclick="
                const card = this.closest('.carta');
                const equipadoInput = card.querySelector('[data-label=Equipar] input');
                const customitemInput = card.querySelector('.carta-customitem');
                const seq = nextItemSeq('<%= phi.id %>');

                setItemCardStateToBoth(card, false);
                fetch(
                  '<%= update_field_personaje_path(phi.personaje, field: 'item_restaurar', target_id: phi.id) %>'
                  + '?cantidad=' + encodeURIComponent(card.querySelector('.pj-cantidad').value)
                  + '&is_equipped=' + (!(equipadoInput.type === 'checkbox') || equipadoInput.checked ? '1' : '0')
                  + (customitemInput ? '&customitem=' + encodeURIComponent(customitemInput.value)
                    : '&item_id=' + encodeURIComponent(card.dataset.itemId))
                  + '&seq=' + seq);
            ">
          Restaurar</span>
      </span>
  </div>

  <% if item %>
    <div class="full_container">
      <%= render "items/item", item: item, sobreescritura: phi.sobreescritura, hide_add: true %>
    </div>
  <% end %>
</div>