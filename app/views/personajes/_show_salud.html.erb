<%# Expected params: pc %>
<%= turbo_frame_tag "partecuerpo-#{pc.id}_salud" do %>
  <span class="pjv-var-cuerpo-big"><%=pc.state%> </span> 
  <input type="hidden" name="parte_cuerpos[<%= pc.id %>][saludact]" value="<%= pc.saludact %>">
  <span class="pjv-var-cuerpo-act">
    <%= pc.saludact%>
  </span>
  / 
  <%= pc.saludmax%>
  <%= parte_cuerpo_link pc, :aumentar,  "partecuerpo-#{pc.id}_aumentar"  %>
  <%= parte_cuerpo_link pc, :disminuir, "partecuerpo-#{pc.id}_disminuir" %>
<% end %>