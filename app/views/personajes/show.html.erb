<p style="color: green"><%= notice %></p>

<%= render @x %>

<div>
  <%= link_to "Editar", edit_habilidad_path(@x), class: "btn btn-primary" %>
  <%= link_to "Eliminar", habilidad_path(@x), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class: "btn btn-danger" %>
  <%= link_to "Volver", personajes_path, class: "btn btn-primary" %>
</div>
