<% importJS "modals" %>

<%= form_with model: mob do |form| %>
  <div>
    <%= form.label :nombre %><br>
    <%= form.text_field :nombre %>
  </div>
  <br>

  <div>
    <%= form.label :estabilidad %><br>
    <%= form.number_field :estabilidad %>
  </div>
  <br>

  <div>
    <%= form.label :sangre %><br>
    <%= form.number_field :sangre %>
  </div>
  <br>

  <div>
    <%= form.label :armaduraMagica %><br>
    <%= form.number_field :armaduraMagica %>
  </div>
  <br>

  <div>
    <%= form.label :penetracionFisica %><br>
    <%= form.number_field :penetracionFisica %>
  </div>
  <br>

  <div>
    <%= form.label :penetracionMagica %><br>
    <%= form.number_field :penetracionMagica %>
  </div>
  <br>

  <div>
    <%= form.label :cuerpo %><br>
    <%= form.rich_text_area :cuerpo %><br>
  </div>
  <br>

  <div>
    <%= form.label :descripcion %><br>
    <%= form.rich_text_area :descripcion %><br>
  </div>
  <br>

  <div>
    <%= form.label :oro %><br>
    <%= form.number_field :oro, step: :any %>
  </div>
  <br>

  <%= render "shared/modal",
      buttom_content: "Seleccionar ítems de loot",
      header_text: "Ítems de loot",
      index: "mob-items" do %>
    <% Item.order(:nombre).each do |item| %>
      <%= form.fields_for :mob_has_items, mob.mob_has_items.find { |mhi| mhi.item_id == item.id } || MobHasItem.new do |mhi_form| %>
        <div>
          <%= mhi_form.check_box :item_id, { multiple: false }, item.id, nil %>
          <%= item.nombre %>
          <%= mhi_form.number_field :cantidad, value: (mhi_form.object.cantidad || 1), min: 1, step: 1 %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <br>
  <br>

  <div>
    <%= form.label :habilidadsOfMob_ids, 'Habilidades que tiene' %><br>
    <%= form.collection_select :habilidadsOfMob_ids, Habilidad.order(:nombre), :id, :nombre, {}, multiple: true, class: "form-select" %>
  </div>
  <br>

  <div>
    <%= form.label :image %><br>
    <%= form.file_field :image %>
  </div>

  <%= render "shared/image", image: mob.image %>
  <br>

  <div>
    <%= form.submit %>
  </div>
<% end %>