# Configuration for ImageUploaderConfig

# Images storage backend
# Type: required
# Options: database, carrierwave, minio
IMAGE_STORAGE_BACKEND=minio

# Image cache
# Type: optional
# Options: true, false
# Default: false
CACHE_IS_DISK=true
CACHE_IS_MEMORY=true

# Maximum memory cache size in MB
# Type: optional
# Options: >=0
# Default: 50
IMAGE_CACHE_MEMORY_SIZE_MB=50

# Try to migrate database on initializers/db_migration.rb (only if needed)
# Type: optional
# Options: true, false
# Default: false
MIGRATE_ON_INIT=true

# Established max file size (MB) allowed for images during backup restore
#  (if option is selected during restore)
# Type: optional
# Options: >=0
# Default: 10
#BACKUP_UPLOAD_MAX_FILE_SIZE_MB=1
