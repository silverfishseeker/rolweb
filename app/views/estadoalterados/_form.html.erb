<%= form_with model: @x do |form| %>
  <div>
    <%= form.label :nombre %><br>
    <%= form.text_field :nombre %>
  </div>
  <br>
  <div>
    <%= form.label :isNumeric %><br>
    <%= form.check_box :isNumeric %>
  </div>
  <br>
  <div>
    <%= form.label :ambito %><br>
    <%= form.select :ambito, Estadoalterado::AMBITOS.map { |a| [a || "Sin ámbito", a] } %>
  </div>
  <br>
  <div>
    <%= form.label :descripcion %><br>
    <%= form.rich_text_area :descripcion %>
  </div>
  <br>
    
  <div>
    <%= form.submit %>
  </div>
<% end %>