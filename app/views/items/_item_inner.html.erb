<% importJS "fixAllInputNumber" %>

<div class="carta-header">
    <p class="carta-number carta-coste">
        <%= item.coste %>
    </p>
    <p class="carta-number carta-peso">
        <%= item.peso %>
    </p>
    <%= link_to item.nombre, item, class: "carta-title"%>
</div>

<div class="carta-subtitles">
    <% item.clases.each do |clase| %>
        <%= link_to clase.nombre, clase %>
    <% end %>
</div>

<div class="carta-description">
    <%= item.ritual_description %>
    <%= local_assigns[:sobreescritura] || item.efecto %>
</div>

<% if user_signed_in? && controller.has_level?(:player) && !hide_add %>
  <hr>
  <h4>Añadir a personaje</h4>
    <% if current_user.personajes.any? %>
        <%= form_with(url: add_to_personaje_item_path(item), method: :post) do |f| %>
            <%= hidden_field_tag :item_id, item.id %>
            <%= select_tag(:personaje_id, options_from_collection_for_select(current_user.personajes,:id,:nombre)) %>
            <%= number_field_tag :cantidad, 1, step: 1 %>
            <%= f.submit "Añadir", class: "btn btn-primary btn-small" %>
            <br>
            <%= render "items/add_to_personaje_flash", item_id: item.id, added: false %>
        <% end %>
    <% end %>
<% end %>