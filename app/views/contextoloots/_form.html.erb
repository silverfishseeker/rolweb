<%= form_with model: x do |form| %>

  <div>
    <%= form.label :nombre %>
    <%= form.text_field :nombre %>
  </div>
  <br>
  
  <%= render "shared/fcs", p:"item", form: form %>
  <br>
  
  <%= render "shared/fcs", p:"categ", form: form %>
  <br>

  <div>
    <%= form.submit %>
  </div>
<% end %>
