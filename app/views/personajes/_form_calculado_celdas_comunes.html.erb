<%# Expected params: index, calc %>
<input type="hidden" name="calculados[<%= index %>][id]" value="<%= calc&.id %>">
<td data-label="Incremento por efectos permanentes">
  <input type="number"
        name="calculados[<%= index %>][passive_mod]"
        value="<%= calc&.modificable&.passive_mod || 0%>">
</td>
<td data-label="Incremento por efectos temporales">
  <input type="number"
        name="calculados[<%= index %>][active_mod]"
        value="<%= calc&.modificable&.active_mod || 0 %>">
</td>
<td data-label="Valor calculado">
  <%= calc&.value || "ninguno" %>
</td>
<%= yield %>
<td data-label="Orden">
  <% if local_assigns[:orderable] == false %>
    <span class="pjv-pos_unavailable" title="Esta fila tiene una posición fija y no se puede reordenar">✕</span>
  <% else %>
    <input type="hidden" class="pjv-orden_input" name="calculados[<%= index %>][orden]" value="<%= index %>">
    <%= render "personajes/position_controller", id_prefix: id_prefix %>
  <% end %>
</td>
<td data-label="Borrar">
  <% if local_assigns[:destroyable] != false %>
    <input type="checkbox"
          name="calculados[<%= index %>][_destroy]"
          value="1"
          <%= "checked" if !calc.present? %>
          class="rm_input"
          data-rm_type="0">
  <% else %>
    <span title="No se puede eliminar: todos los personajes deben tenerlo.">✖</span>
  <% end %>
</td>
