<div class="categ"> <%# categ no tiene estilos definidos, es para el liveSearch.js%>
    <h2><%=link_to x.nombre, x%></h2>

    <div class="carta-grid_container">
        <% x.items.order(coste: :asc, nombre: :asc).each do |item| %>
            <%= render "items/item", item: item %>
        <% end %>
    </div>

    <br>
</div>