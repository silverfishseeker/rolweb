<h1>Editar usuario</h1>

<%= form_with model: @x, local: true do |f| %>

  <div>
    <%= f.label :email %><br>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :nombre %><br>
    <%= f.text_field :nombre %>
  </div>

  <div>
    <%= f.label :rango %><br>
    <%= f.select :rango,
        AccessControl::LEVELS_NAMES[1..].each_with_index.map { |name, i| [name, i+1] },
        {}, class: "form-control" %>
  </div>

  <br>

  <%= f.submit "Guardar cambios" %>
<% end %>
