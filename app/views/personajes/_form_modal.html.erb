<%# Expected params: buttom_text, buttom_extra_css, header_text, index, &block, close_buttom_extra_css %>
<%# index must contain a prefix so it is unique between different kinds of models using the modals %>

<button type="button"
        class="open_modal btn btn-primary btn-small <%= local_assigns[:buttom_extra_css] %>" <%# Con local_assigns la variable no da error si no se asigna y devuelve nil %>
        id="btn-estados-<%=index%>"
        data-index="modal-<%=index%>">
  <%= buttom_text %>
</button>
<div id="modal-<%=index%>" class="pj-modal">
  <header>
    <h4><%= header_text %></h4>
    <button type="button" class="btn btn-danger modal-close <%= local_assigns[:close_buttom_extra_css] %>"
          data-index="modal-<%=index%>">
      Guardar y cerrar
    </button>
  </header>
  <div class="pj-modal_content">
    <%= yield %>
  </div>
</div>