<%# Expected params: index, target, (optional) buttom_content, (optional) buttom_extra_css, (optional) horizontal%>
<div class="estado-resumen <%= "pjv-estados_alterados-horizontal" if local_assigns[:horizontal] %>"
    id="resumen-modal-partecuerpo-<%=index%>" data-table_id="<%=ea_t_id index.to_s%>">
  <!-- JS rellena -->
</div>
<%= render "personajes/form_modal",
            buttom_content: local_assigns[:buttom_content] || "Ver / editar",
            buttom_extra_css: local_assigns[:buttom_extra_css] || "",
            header_text: "Estados alterados de #{target ? target.nombre : "nuevo"}",
            index: "partecuerpo-#{index}",
            default_close: false,
            close_buttom_extra_css: "modal-close-resumen" do %>
    <%= render "personajes/form_estados_alterados",
                listaEstadosAlterados: target ? target.hasEstadoalterados : [],
                nombre_input_base: "parte_cuerpos[#{index}][has_estadoalterados]",
                table_id: index %>
<% end %>