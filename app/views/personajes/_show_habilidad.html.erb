<div class="carta carta_show">
  <% habil = phh.habilidad %>
  <div class="carta-header carta-header-small">
      <p class="carta-number carta-level">
          <%= habil.nivel %>
      </p>

      <%= image_tag habil.tipoImagen, class: "carta-isactive" %>

      <%= link_to habil.nombre, habil, class:"carta-title" %>

      <%= render "personajes/show_contadores", calculados: phh.calculados, prefix: "phh[#{phh.id}]" %>
  </div>

  <div class="full_container">
    <%= render "habilidads/habilidad", habil: habil%>
  </div>
</div>
