<%# _form_estados_alterados.html.erb %>
<%# Params: listaEstadosAlterados, nombre_input_base, table_id %>
<table class="tabla-estadisticas" id="table_<%= table_id %>">
  <thead>
    <tr>
      <th>Estado</th>
      <th>Valor</th>
      <th>Eliminar</th>
    </tr>
  </thead>
  <tbody>
    <% index = 0%>
    <% listaEstadosAlterados.each do |ea| %>
      <tr data-id="<%= index %>">
        <td data-label="Estado">
          <%= ea.EstadoAlterado.nombre %>
        </td>
        <td data-label="Valor">
          <% if ea.EstadoAlterado.isNumeric %>
            <input type="number"
                   name="<%= "#{nombre_input_base}[#{index}][valor]" %>"
                   value="<%= ea.valor %>">
          <% else %>
            —
          <% end %>
        </td>
        <td data-label="Eliminar" class="checkbox-danger">
          <input type="checkbox"
                 name="<%= "#{nombre_input_base}[#{index}][_destroy]" %>"
                 value="1">
        </td>
      </tr>
      <%= hidden_field_tag "#{nombre_input_base}[#{index}][id]", ea.id %>
      <%= hidden_field_tag "#{nombre_input_base}[#{index}][estadoalterado_id]", ea.EstadoAlterado.id %>
      <% index += 1 %>
    <% end %>
  </tbody>
</table>
<button type="button" class="btn btn-primary add-estadoalterado" table_id="table_<%= table_id %>">Añadir estado alterado</button>
