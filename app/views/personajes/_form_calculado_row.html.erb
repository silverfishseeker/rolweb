<input type="hidden" name="calculados[<%= index %>][id]" value="<%= calc&.id %>">
<td> <!-- PASSIVE MOD -->
  <input type="number"
        name="calculados[<%= index %>][passive_mod]"
        value="<%= calc&.modificable&.passive_mod || 0%>">
</td>
<td> <!-- ACTIVE MOD -->
  <input type="number"
        name="calculados[<%= index %>][active_mod]"
        value="<%= calc&.modificable&.active_mod || 0 %>">
</td>
<td> <!-- VALOR CALCULADO -->
  <%= calc&.value || "ninguno" %>
</td>
<%= yield %>
<td class="checkbox-danger"> <!-- BORRAR -->
  <input type="checkbox"
        name="calculados[<%= index %>][_destroy]"
        value="1"
        <%= "checked" if !calc.present? %>>
</td>