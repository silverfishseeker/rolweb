<% only_admin_content do %>
    <div class="admin-actions">
        <%= link_to "Edit", edit_item_path(@x), class: "btn btn-primary" %>
        <%= link_to "Destroy", item_path(@x), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class: "btn btn-danger" %>
    </div>
<% end %>

<div class="miniListadoClases">
    <% @x.categs.each do |ct| %>
        <%= link_to ct.nombre, ct, class: "carta-title" %>
    <% end %>
</div>

<div class="clase-main">
    <div class="carta carta_extendida texto_info-margins carta_fixInnerImage">
        <%= render("shared/image_with_link", image: @x.image, cssclass: "carta-image") if @x.image%>
        <div>
            <%= render "item_inner", item: @x, hide_add: false %>
        </div>
    </div>
</div>

<% only_admin_content do %>
    <%  contextoloots = @x.all_contextoloots %>
    <% if contextoloots.any? %>
        <h3> Contextloots relacionados:</h3>
        <div class="miniListadoClases">
            <% contextoloots.each do |cl| %>
                <%= link_to cl.nombre, cl, class: "carta-title" %>
            <% end %>
        </div>
    <% end %>
    <% if @x.usecategloot %>
        <h4> Se usan contextloots de categorías. </h4>
    <% else %>
        <h4> No se usan contextloots de categorías. </h4>
    <% end %>
<% end %>

<br>

<% if @x.habilidads.any? %>
    <h1>Lista de Hablidades relacionadas:</h1>
    <%= render "habilidads/lista", habilidades: @x.habilidads%>
<% end %>