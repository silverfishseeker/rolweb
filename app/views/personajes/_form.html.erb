<%# expected params: @x (Personaje)%>
<% importJS "personajeForm", "modals", "estadosAlterados" %>
<%# Requerido por estadosAlterados %>
<!-- ================= AÑADIR ESTADO ALTERADO ================= -->
<script type="text/template" id="estadoalterado-template">
  <tr data-id="__id__">
    <td data-label="Estado">
      <select name="<%= "__nombre_input_base__[__id__][estadoalterado_id]" %>">
        <% Estadoalterado.order(:nombre).each do |ea| %>
          <option value="<%= ea.id %>"
                data-is-numeric="<%= ea.isNumeric %>">
            <%= ea.nombre %>
          </option>
        <% end %>
      </select>
    </td>
    <td data-label="Valor">
      <input type="number" name="<%= "__nombre_input_base__[__id__][valor]" %>" value="0">
    </td>
    <td data-label="Eliminar" class="checkbox-danger">
      <input type="checkbox" name="<%= "__nombre_input_base__[__id__][_destroy]" %>" value="1">
    </td>
  </tr>
</script>

  <!-- ================= AÑADIR ESTADO ALTERADO LIBRE ================= -->

<script type="text/template" id="estadoalterado-template-libre">
  <tr data-id="__id__">
    <td data-label="" colspan="2">
      <input type="text" name="__nombre_input_base__[__id__][libre]">
    </td>
    <td data-label="Eliminar" class="checkbox-danger">
      <input type="checkbox" name="__nombre_input_base__[__id__][_destroy]" value="1">
    </td>
  </tr>
</script>
<% content_for :main_content_class, 'main-content-margin_reduced' %>

<div>
  <%= form_with(model: @x, html: { multipart: true, class: "pj-form", data: { base_path: (@x.persisted? ? personaje_path(@x) : nil) } }) do |f| %> <%# base_path is called dataset.basePath in JavaScript %>
    <% if @show_user %>
      <label>
        <%= f.label :user_id, "Usuario" %>
        <%= f.collection_select(
            :user_id,
            User.order(:nombre),
            :id,
            :nombre
        ) %>
      </label>
    <% end %>

    <header class="pj-header">
      <h1>
        <%= f.object.new_record? ? "Nuevo personaje" : "Editando Personaje: #{@x.nombre}" %>
      </h1>
      <div class="options">
        <%= f.submit "Guardar", class: "btn btn-primary" %>
        <%= f.button "Guardar y continuar editando", name: "commit", value: PersonajesController::COMMIT_TO_EDIT, class: "btn btn-primary" %>
        <%= link_to "Cancelar", @x, class: "btn btn-danger",
            data: { turbo_confirm: "¿Seguro que quieres cancelar? Se perderán los cambios." } %>
      </div>
    </header>

    <div class="pj-tabs">
      <div class="pj-tabs-nav">
        <div data_tab_target="#tab-general" class="pj-tabs-nav-active">General</div>
        <div data_tab_target="#tab-estado">Estado y cuerpo</div>
        <div data_tab_target="#tab-clases">Clases & Habilidades</div>
        <div data_tab_target="#tab-items">Inventario</div>
      </div>

      <div class="pj-tab-container">
        <!-- GENERAL -->
        <div id="tab-general" class="pj-tab_pane pj-tab_pane-active">

          <section class="columns">
            <div>
              <h2>
                <%= f.text_field :nombre, class: "form-control", placeholder: "Nombre del personaje", required: true %>
              </h2>

              <div>
                <label>
                  <%= f.label :personajegroup_id, "Selecciona grupo de usuarios (opcional)" %>
                  <%= f.collection_select(
                      :personajegroup_id,
                      Personajegroup.order(:nombre),
                      :id,
                      :nombre,
                      { include_blank: "Sin grupo" }
                  ) %>
                </label>
              </div>
              <p><i> Al añadir tu personaje a un grupo le estás dando permisos al propietario de
                grupo para ver y editar tu personaje. Si añades tu personaje a un grupo, ten cuidado
                de que sea el apropiado.</i></p>
              <br>

              <div>
                <label>
                  <%= f.check_box :is_public %> Publicar para que todos puedan verlo.
                  <i>(Se muestra sólo la portada, no el contenido.)</i>
                </label>
              </div>
              <h3>Niveles del personaje</h3>

              <table class="pj-niveles-table" id="pj-niveles-table">
                <thead>
                  <tr>
                    <th>Tipo</th>
                    <th>Valor</th>
                    <th></th>
                    <th>Valor calculado</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>TOTAL</td>
                    <td colspan="3">
                      <span class="calculado">
                        <%= @x.nivel %>
                      </span>
                    </td>
                  </tr>
                  <% niveles = [
                    [:nivel_clases,       "Clases",       :calc_nivel_clases],
                    [:nivel_habilidades,  "Habilidades",  :calc_nivel_habilidades],
                    [:nivel_estadisticas, "Estadísticas", :calc_nivel_estadisticas],
                    [:nivel_otro,         "Otro", nil]
                  ] %>
                  <% niveles.each do |attr, label, function| %>
                    <tr>
                      <td><%= label %></td>
                      <td> <%= f.number_field attr, class: "pj-nivel-input", data: { field: attr } %> </td>
                      <% if attr != :nivel_otro %>
                      <td class="has_button"> <button type="button" class="btn btn-primary" data-field="<%= attr %>"> ⬅ </button> </td>
                      <td>
                        <span class="calculado" data-field="<%= attr %>">
                          <%= @x.public_send(function) %>
                        </span>
                      </td>
                      <% else %>
                        <td> — </td>
                        <td> — </td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
              <h3> Estadísticas</h3>
              <table class="tabla-estadisticas">
                <thead>
                  <tr>
                    <th>Aplicar</th>
                    <th>Nombre</th>
                    <th>Valor actual</th>
                    <th>Valor base</th>
                    <th>Incremento de niveles</th>
                    <th>Incremento por efectos permanentes</th>
                    <th>Incremento por efectos temporales</th>
                    <th>Orden</th>
                  </tr>
                </thead>
                <tbody>

                <% Pj::TipoEstadistic.all.map do |tipo|
                  [tipo, @x.estadistics.find { |s| s.tipoEstadistic == tipo }] # Obtener cada estadística que el personaje tenga
                end.sort_by do |tipo, stat|
                  [stat ? 0 : 1, stat&.ordenado_position || tipo.orden] # Al ordenar, agrupamos por estadisticas que tiene el personaje y que no. Las que tiene usan Ordenado y las que no usan el orden propio
                end.each do |tipo, stat| %>
                  <tr class="<%= "pj-fila_borrada" if !stat %>" id="est-<%= tipo.id %>"
                      <% if stat %>data-ordenado-id="<%= stat.ordenado_for.id %>"<% end %>>
                    <td data-label="Aplicar">
                      <input type="checkbox"
                            name="estadistics[<%= tipo.id %>][apply]"
                            value="1"
                            <%= "checked" if stat %>
                            class="rm_input"
                            data-rm_type="1">
                    </td>
                    <td data-label="Nombre"><%= "#{tipo.nombre} (#{tipo.siglas})" %></td>
                    <td data-label="Valor actual">
                      <%= stat&.value %>
                    </td>
                    <td data-label="Valor base">
                      <input type="number"
                            name="estadistics[<%= tipo.id %>][base]"
                            value="<%= stat&.base %>">
                    </td>
                    <td data-label="Incremento por niveles">
                      <input type="number"
                            name="estadistics[<%= tipo.id %>][lv_mod]"
                            value="<%= stat&.lv_mod %>">
                    </td>
                    <td data-label="Incremento por efectos permanentes">
                      <input type="number"
                            name="estadistics[<%= tipo.id %>][passive_mod]"
                            value="<%= stat&.modificable&.passive_mod %>">
                    </td>
                    <td data-label="Incremento por efectos temporales">
                      <input type="number"
                            name="estadistics[<%= tipo.id %>][active_mod]"
                            value="<%= stat&.modificable&.active_mod %>">
                    </td>
                    <td data-label="Orden">
                      <% if stat %>
                        <%= render "personajes/show_position_controller", id_prefix: "est-#{tipo.id}" %>
                      <% else %>
                        <span class="pjv-pos_unavailable" title="<%= Pj::Ordenado::MENSAJE_ORDEN_PENDIENTE_GUARDAR %>">✕</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>

            <div>
              <% if @x.picture %>
                <%= render "shared/image_with_link", image: @x.picture.image, cssclass: "pj-image" %>
              <% else %>
                <div class="pj-image-placeholder">Sin imagen</div>
              <% end %>
              <br>
              <div>
                <%= label_tag  "picture_file", "Subir imagen" %>
                <%= file_field_tag "picture[file]" %>
                <br><br>
                <%= label_tag  "picture_nombre", "Título de la imagen" %>
                <%= text_field_tag "picture[nombre]", @x.picture&.nombre %>
                <br><br>
                <%= render "shared/modal",
                    buttom_content: "Editar etiquetas de la imagen",
                    header_text: "Etiquetas de la imagen de #{@x.nombre}",
                    index: "picture_etiquets" do %>
                  <div class="pj-modal_checkbox_list">
                    <%= collection_check_boxes :picture, :etiquet_ids, Etiquet.all, :id, :nombre, checked: @x.picture&.etiquet_ids || [] do |etiquet| %>
                      <div>
                        <%= etiquet.check_box %>
                        <%= etiquet.label %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </section>
          <br>
          <br>
          <section>
            <%= render "shared/modal",
                buttom_content: "Editar artículos relacionados",
                header_text: "Editando artículos relacionados de #{@x.nombre}",
                index: "cuentos" do %>
              <div class="pj-modal_checkbox_list">
                <%= f.collection_check_boxes :cuento_ids, Cuento.all, :id, :nombre do |cuento| %>
                  <div>
                    <%= cuento.check_box %>
                    <%= cuento.label %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </section>
          <section>
            <h3>Notas</h3>
            <div class="white_bk"><%= f.rich_text_area :descripcion %></div>
          </section>

        </div>

        <!-- ESTADO -->
        <div id="tab-estado" class="pj-tab_pane">
          <section class="columns">
            <div>
              <h3>Estado</h3>
              <table class="tabla-estadisticas">
                <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Estadísca base</th>
                    <th>Valor base</th>
                    <th>Incremento por efectos permanentes</th>
                    <th>Incremento por efectos temporales</th>
                    <th>Valor calculado</th>
                    <th>Valor actual</th> <!-- si es un rango-->
                    <th>Orden</th>
                    <th>Borrar</th>
                  </tr>
                </thead>
                <tbody id="calculados-body">
                  <% index = 0 %>
                  <!-- ================= PESO (fija, sin orden) ================= -->
                  <% peso_tipo = Pj::TipoRango.find_by(clave: "peso")
                     peso_calc = @x.peso_calculado %>
                  <% if peso_tipo %>
                    <%= render "form_calculado_dependiente_row", tipo: peso_tipo, calc: peso_calc, index: index, isR: true, orderable: false, destroyable: false do %>
                      <td data-label="Valor actual">
                        <input type="hidden" name="calculados[<%= index %>][rango]" value="<%= @x.peso_actual %>">
                        <span title="El peso actual se calcula automáticamente a partir de tu inventario.">
                          <%= @x.peso_actual %>
                        </span>
                      </td>
                    <% end %>
                    <% index += 1 %>
                  <% end %>

                  <!-- ================= DEPENDIENTES + LIBRES (orden combinado) ================= -->
                  <% dependientes = (Pj::TipoCalculado.order(:orden).to_a + Pj::TipoRango.order(:orden).to_a)
                       .reject { |tipo| tipo == peso_tipo }
                       .map do |tipo|
                         isR = tipo.is_a?(Pj::TipoRango)
                         calc = @x.calculados.find do |c|
                           if isR
                             c.rango ? c.rango.tipoRango_id == tipo.id : false
                           else
                             c.tipoCalculado_id == tipo.id
                           end
                         end # It is allowed for calc to be nil
                         { tipo: tipo, isR: isR, calc: calc, libre: false }
                       end
                     libres = @x.calculados.select(&:calculado_libre).map { |calc| { calc: calc, libre: true } }
                     filas = (dependientes + libres).sort_by.with_index { |fila, i| [fila[:calc] ? 0 : 1, fila[:calc]&.ordenado_position || i] } %>
                  <% filas.each do |fila| %>
                    <% calc = fila[:calc] %>
                    <% if fila[:libre] %>
                      <% libre = calc.calculado_libre
                         id_prefix = "calc-#{calc.id}" %>
                      <tr data-index="<%= index %>" id="<%= id_prefix %>" data-ordenado-id="<%= calc.ordenado_for.id %>">
                        <td data-label="Nombre">
                          <input type="text"
                                name="calculados[<%= index %>][nombre]"
                                value="<%= libre.nombre %>">
                        </td>
                        <td data-label="Estadística base">—</td>
                        <td data-label="Valor base">
                          <input type="number"
                                name="calculados[<%= index %>][base]"
                                value="<%= libre.base %>">
                        </td>
                        <%= render "personajes/form_calculado_celdas_comunes", calc: calc, index: index, id_prefix: id_prefix do %>
                          <td data-label="Valor actual">
                            <input type="number"
                                  name="calculados[<%= index %>][rango]"
                                  value="<%= calc&.rango&.valor || 0 %>"
                                  class="rango-input"
                                  <%= "disabled" unless calc&.rango.present? %>>
                          <button type="button" class="toggle-rango">R</button>
                          </td>
                        <% end %>
                      </tr>
                    <% else %>
                      <% tipo = fila[:tipo]; isR = fila[:isR] %>
                      <%= render "form_calculado_dependiente_row", tipo: tipo, calc: calc, index: index, isR: isR do %>
                        <td data-label="Valor actual">
                          <% if isR %>
                            <input type="number"
                                  name="calculados[<%= index %>][rango]"
                                  value="<%= calc&.rango&.valor || 0 %>"
                                  class="rango-input">
                          <% else %>
                            —
                          <% end %>
                        </td>
                      <% end %>
                    <% end %>
                    <% index += 1 %>
                  <% end %>

                  <!-- ================= AÑADIR LIBRE ================= -->
                  <script type="text/template" id="calculado-libre-template">
                    <tr data-index="__INDEX__">
                      <td data-label="Nombre">
                        <input type="text"
                              name="calculados[__INDEX__][nombre]">
                      </td>
                      <td data-label="Estadística base">—</td>
                      <td data-label="Valor base">
                        <input type="number"
                              name="calculados[__INDEX__][base]">
                      </td>
                      <td data-label="Incremento por efectos permanentes">
                        <input type="number"
                              name="calculados[__INDEX__][passive_mod]"
                              value="0">
                      </td>
                      <td data-label="Incremento por efectos temporales">
                        <input type="number"
                              name="calculados[__INDEX__][active_mod]"
                              value="0">
                      </td>
                      <td data-label="Valor calculado">—</td>

                      <td data-label="Valor actual">
                        <input type="number"
                              name="calculados[__INDEX__][rango]"
                              class="rango-input"
                              disabled>
                        <button type="button" class="toggle-rango">R</button>
                      </td>
                      <td data-label="Orden">
                        <span class="pjv-pos_unavailable" title="<%= Pj::Ordenado::MENSAJE_ORDEN_PENDIENTE_GUARDAR %>">✕</span>
                      </td>
                      <td data-label="Borrar" class="checkbox-danger">
                        <input type="checkbox"
                              name="calculados[__INDEX__][_destroy]"
                              value="1">
                      </td>
                    </tr>
                  </script>
                  <tr>
                    <td colspan="9">
                      <button type="button" id="add-calculado-libre" class="btn btn-primary">
                        + Añadir característica
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div>
              <!-- ================= ESTADOS ALTERADOS ================= -->
              <h3>Estados alterados</h3>
              <%= render "personajes/form_estados_alterados",
                         listaEstadosAlterados: @x.hasEstadoalterados,
                         nombre_input_base: "has_estadoalterados",
                         table_id: "general" %>


              <!-- ================= AÑADIR PARTE CUERPO ================= -->
              <script type="text/template" id="parte-cuerpo-template">
                <%= render "form_parte_cuerpo_row", index: "__INDEX__", pc: nil %>
              </script>
              <!-- ================= PARTES CUERPO ================= -->
              <h3>Cuerpo</h3>
              <table class="tabla-estadisticas" id="parte-cuerpos-table">
                <thead>
                  <tr>
                    <th>Parte</th>
                    <th>Tipo</th>
                    <th>Salud</th>
                    <th>Mapeo</th>
                    <th>Armadura base</th>
                    <th>Modificador armadura</th>
                    <th>Estados alterados</th>
                    <th>Orden</th>
                    <th>Borrar</th>
                  </tr>
                </thead>

                <tbody id="parte-cuerpos-body">
                  <% @x.parteCuerpos.sort_by(&:ordenado_position).each_with_index do |pc, i| %>
                    <%= render "form_parte_cuerpo_row", index: i, pc: pc %>
                  <% end %>
                  <tr style="display:none;" id="parte-cuerpos-next"> </tr>
                </tbody>
              </table>

              <button type="button" id="add-parte-cuerpo" class="btn btn-primary">
                Añadir parte del cuerpo
              </button>
              
              <br>
              <div id="explicacion-mapeos-container">
                <%= render "shared/modal",
                    buttom_content: "Cómo configurar los mapeos de partes del cuerpo",
                    buttom_extra_css: "to_right",
                    header_text: "Explicación de mapeos de partes del cuerpo",
                    index: "explicacion-mapeos" do %>
                    <p> El mapeo asigna una letra, símbolo o palabra a cada estado de salud de la parte del cuerpo.</p>
                    <p> Si tu personaje no tiene nada especial al respecto déjalo por defecto y no te preocupes.
                        (Existen mapeos predefinidos hasta 9 estados de salud.) </p>
                    <p> Si quieres usar un mapeo personalizado debes de seguir el siguiente formato. Tienes dos opciones: </p>
                    <ul>
                      <li><b>1.</b> Usar un carácter o letra por cada estado de salud. Es imprescindible que el número de
                        caracteres coincida con la salud máxima de esa parte del cuerpo o dará error.</li>
                      <li><b>2.</b> Usar el carácter "@" como separador entre los estados de salud. En vez de un único caracter
                        puedes usar palabras para representar el estado de salud. Igualmente es imprescindible que el número de
                        palabras coincida con la salud máxima de esa parte del cuerpo o dará error.</li>
                    </ul>
                <% end %>
              </div>

            </div>
          </section>
        </div>

        <script type="text/template" id="contador-template">
          <%# Carece de input de id a propósito%>
          <tr>
            <td data-label="Nombre">
              <input type="text"
                    name="__PREFIX__[nombre]">
            </td>
            <td data-label="Valor base">
              <input type="number"
                    name="__PREFIX__[base]">
            </td>
            <td data-label="Valor actual">
              <input type="number"
                    name="__PREFIX__[rango]"
                    class="rango-input"
                    disabled>
              <button type="button" class="toggle-rango">R</button>
            </td>
            <td data-label="Borrar" class="checkbox-danger">
              <input type="checkbox"
                    class="rm_input"
                    name="__PREFIX__[_destroy]"
                    value="1">
            </td>
          </tr>
        </script>

        <!-- CLASES Y HABILIDADES -->
        <div id="tab-clases" class="pj-tab_pane" data-lazy-section="clases_tab">
          <h4>Notas</h4>
          <p> Está permitido aprender habilidades de clases que no has aprendido. </p>
          <p> Si cambias la clase de una habilidad, la habilidad aparecerá en la sección de la clase a la que has cambiado, (incluso si no has aprendido esa clase).</p>
          <p> No puedes aprender la misma habilidad varias veces (desde clases distintas), si lo haces el sistema dará un aviso y seleccionará una aleatoriamente como la buena.</p>
          <% if @x.persisted? %>
            <div id="tab-clases-content" data-loaded="0"></div>
          <% else %>
            <div id="tab-clases-content" data-loaded="1">
              <%= render "form_clases_tab" %>
            </div>
          <% end %>
        </div>

        <!-- INVENTARIO -->
        <div id="tab-items" class="pj-tab_pane" data-lazy-section="items_tab">
          <h2>Oro: <%= f.number_field :oro, step: 0.01 %> </h2>
          <p> Selecciona la cantidad de cada ítem que tienes en
            el número arriba a la izquierda. Puedes tener 0 de un ítem.</p>
          <p> No puedes tener el mismo ítem varias veces desde diferentes
             categorías, si lo haces el sistema dará un aviso y seleccionará
              una aleatoriamente como el bueno. Si quieres más de un mismo
              ítem, simplemente aumenta la cantidad.</p>
          <% if @x.persisted? %>
            <div id="tab-items-content" data-loaded="0"></div>
          <% else %>
            <div id="tab-items-content" data-loaded="1">
              <%= render "form_items_tab" %>
            </div>
          <% end %>
        </div>

      </div>
    </div>
  <% end %>
</div>
