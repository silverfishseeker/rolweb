<div class="carta carta_show" id="phh-<%= phh.id %>" data-ordenado-id="<%= phh.ordenado_for.id %>">
  <% habil = phh.habilidad %>
  <div class="carta-header carta-header-small">
      <%= render "personajes/show_position_controller", id_prefix: "phh-#{phh.id}" %>

      <p class="carta-number carta-level">
          <%= habil.nivel %>
      </p>

      <%= image_tag habil.tipoImagen, class: "carta-isactive" %>

      <%= link_to habil.nombre, habil, class:"carta-title" %>

      <%= render "personajes/show_contadores", has_calculados: phh, nombre: "phh" %>
  </div>

  <div class="full_container">
    <%= render "habilidads/habilidad", habil: habil, sobreescritura: phh.sobreescritura %>
  </div>
</div>
