<% importJS "personajeForm" %>

<div>
  <%= form_with(model: @x, local: true, html: { multipart: true, class: "pj-form"}) do |f| %>
    <!-- SUBMIT + CANCEL -->
    <div>
      <%= f.submit "Guardar", class: "btn btn-primary" %>
      <%= link_to "Cancelar", personajes_path, class: "btn btn-warning" %>
    </div>

    <div class="pj-tabs">
      <div class="pj-tabs-nav">
        <div data_tab_target="#tab-general" class="pj-tabs-nav-active">General</div>
        <div data_tab_target="#tab-estado">Estado y cuerpo</div>
        <div data_tab_target="#tab-clases">Clases & Habilidades</div>
        <div data_tab_target="#tab-items">Inventario</div>
      </div>

      <div class="pj-tab-container">
        <!-- GENERAL -->
        <div id="tab-general" class="pj-tab_pane pj-tab_pane-active">

          <section class="columns">
            <div>
              <h2>
                <%= f.text_field :nombre, class: "form-control", placeholder: "Nombre del personaje" %>
              </h2>

              <div>
                <label>
                  <%= f.check_box :is_public %> Publicar para que todos puedan verlo. (No recomendable)
                </label>
              </div>
              <h3> Estadísticas</h3>
              <table class="tabla-estadisticas">
                <thead>
                  <tr>
                    <th>Aplicar</th>
                    <th>Nombre</th>
                    <th>Valor actual</th>
                    <th>Valor base</th>
                    <th>Incremento de niveles</th>
                    <th>Incremento por efectos permanentes</th>
                    <th>Incremento por efectos temporales</th>
                  </tr>
                </thead>
                <tbody>

                <% Pj::TipoEstadistic.order(:orden).each do |tipo| %>
                  <% stat = @x.estadistics.find { |s| s.tipoEstadistic == tipo } %>
                  <tr>
                    <td data-label="Aplicar">
                      <input type="checkbox"
                            name="estadistics[<%= tipo.id %>][apply]"
                            value="1"
                            <%= "checked" if stat %>>
                    </td>
                    <td data-label="Nombre"><%= "#{tipo.nombre} (#{tipo.siglas})" %></td>
                    <td data-label="Valor actual">
                      <%= stat&.value %>
                    </td>
                    <td data-label="Valor base">
                      <input type="number"
                            name="estadistics[<%= tipo.id %>][base]"
                            value="<%= stat&.base %>">
                    </td>
                    <td data-label="Incremento por niveles">
                      <input type="number"
                            name="estadistics[<%= tipo.id %>][lv_mod]"
                            value="<%= stat&.lv_mod %>">
                    </td>
                    <td data-label="Incremento por efectos permanentes">
                      <input type="number"
                            name="estadistics[<%= tipo.id %>][passive_mod]"
                            value="<%= stat&.modificable&.passive_mod %>">
                    </td>
                    <td data-label="Incremento por efectos temporales">
                      <input type="number"
                            name="estadistics[<%= tipo.id %>][active_mod]"
                            value="<%= stat&.modificable&.active_mod %>">
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>

            <div>
              <% if @x.picture %>
                <%= render "shared/image_with_link", image: @x.picture.image, cssclass: "pj-image" %>
              <% else %>
                <div class="pj-image-placeholder">Sin imagen</div>
              <% end %>
              <div>
                <%= f.label :picture_id, "Selecciona imagen de la galería:" %>
                <br>
                <%= f.collection_select :picture_id, Picture.order(:nombre), :id, :nombre, include_blank: true %>
              </div>
            </div>
          </section>

          <section>
            <h3>Notas</h3>
            <div class="white_bk"><%= f.rich_text_area :descripcion %></div>
          </section>

        </div>

        <!-- ESTADO -->
        <div id="tab-estado" class="pj-tab_pane">
          <section class="columns">
            <div>
              <h3>Estado</h3>
              <table class="tabla-estadisticas">
                <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Estadísca base</th>
                    <th>Valor base</th>
                    <th>Incremento por efectos permanentes</th>
                    <th>Incremento por efectos temporales</th>
                    <th>Valor calculado</th>
                    <th>Valor actual</th> <!-- si es un rango-->
                    <th>Borrar</th>
                  </tr>
                </thead>
                <tbody id="calculados-body">
                  <% index = 0 %>
                  <!-- ================= DEPENDIENTES ================= -->
                  <% (Pj::TipoCalculado.all + Pj::TipoRango.all).each do |tipo| %>
                    <% isR = tipo.is_a?(Pj::TipoRango)
                      calc = @x.calculados.find do |c|
                        if isR
                          c.rango ? c.rango.tipoRango_id == tipo.id : false
                        else
                          c.tipoCalculado_id == tipo.id
                        end
                      end # It is allowed for calc to be nil
                      estad = @x.estadistics.find do |s|
                        s.tipoEstadistic == tipo.tipoEstadistic
                      end %>
                    <input type="hidden" name="calculados[<%= index %>][tipo_id]" value="<%= tipo.id %>">
                    <input type="hidden" name="calculados[<%= index %>][is_rango]" value="<%= isR ? 1 : 0 %>">
                    <tr data-index="<%= index %>">
                      <td data-label="Nombre">
                        <strong><%= tipo.nombre %></strong>
                      </td>
                      <td data-label="Estadística base">
                        <%= tipo.tipoEstadistic ? tipo.tipoEstadistic.nombre : "—" %>
                      </td>
                      <td data-label="Valor base">
                        <%= estad&.value || "—" %>
                      </td>
                      <%= render "personajes/form_calculado_row", calc: calc, index: index do %>
                          <td data-label="Valor actual">
                          <% if isR %>
                            <input type="number"
                                  name="calculados[<%= index %>][rango]"
                                  value="<%= calc&.rango&.valor || 0 %>"
                                  class="rango-input">
                          <% else %>
                            —
                          <% end %>
                        </td>
                      <% end %>
                    </tr>
                    <% index += 1 %>
                  <% end %>

                  <!-- ================= LIBRES ================= -->
                  <% @x.calculados.select(&:calculado_libre).each do |calc| %>
                    <% libre = calc.calculado_libre %>
                    <tr data-index="<%= calc.id %>">
                      <td data-label="Nombre">
                        <input type="text"
                              name="calculados[<%= index %>][nombre]"
                              value="<%= libre.nombre %>">
                      </td>
                      <td data-label="Estadística base">—</td>
                      <td data-label="Valor base">
                        <input type="number"
                              name="calculados[<%= index %>][base]"
                              value="<%= libre.base %>">
                      </td>
                      <%= render "personajes/form_calculado_row", calc: calc, index: index do %>
                        <td data-label="Valor actual">
                          <input type="number"
                                name="calculados[<%= index %>][rango]"
                                value="<%= calc&.rango&.valor || 0 %>"
                                class="rango-input"
                                <%= "disabled" unless calc&.rango.present? %>>
                        <button type="button" class="toggle-rango">R</button>
                        </td>
                      <% end %>
                    </tr>
                    <% index += 1 %>
                  <% end %>

                  <!-- ================= AÑADIR LIBRE ================= -->
                  <script type="text/template" id="calculado-libre-template">
                    <tr data-index="__INDEX__">
                      <td data-label="Nombre">
                        <input type="text"
                              name="calculados[__INDEX__][nombre]">
                      </td>
                      <td data-label="Estadística base">—</td>
                      <td data-label="Valor base">
                        <input type="number"
                              name="calculados[__INDEX__][base]">
                      </td>
                      <td data-label="Incremento por efectos permanentes">
                        <input type="number"
                              name="calculados[__INDEX__][passive_mod]"
                              value="0">
                      </td>
                      <td data-label="Incremento por efectos temporales">
                        <input type="number"
                              name="calculados[__INDEX__][active_mod]"
                              value="0">
                      </td>
                      <td data-label="Valor calculado">—</td>

                      <td data-label="Valor actual">
                        <input type="number"
                              name="calculados[__INDEX__][rango]"
                              class="rango-input"
                              disabled>
                        <button type="button" class="toggle-rango">R</button>
                      </td>
                      <td data-label="Borrar" class="checkbox-danger">
                        <input type="checkbox"
                              name="calculados[__INDEX__][_destroy]"
                              value="1">
                      </td>
                    </tr>
                  </script>
                  <tr style="display:none;" id="calculado-libre-next"> </tr>
                  <tr>
                    <td colspan="8">
                      <button type="button" id="add-calculado-libre" class="btn btn-primary">
                        + Añadir característica
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div>
              <!-- ================= AÑADIR ESTADO ALTERADO ================= -->
              <script type="text/template" id="estadoalterado-template">
                <tr data-id="__id__">
                  <td data-label="Estado">
                    <select name="<%= "__nombre_input_base__[__id__][estadoalterado_id]" %>">
                      <% Estadoalterado.order(:nombre).each do |ea| %>
                        <option value="<%= ea.id %>"
                              data-is-numeric="<%= ea.isNumeric %>">
                          <%= ea.nombre %>
                        </option>
                      <% end %>
                    </select>
                  </td>
                  <td data-label="Valor">
                    <input type="number" name="<%= "__nombre_input_base__[__id__][valor]" %>" value="0">
                  </td>
                  <td data-label="Eliminar" class="checkbox-danger">
                    <input type="checkbox" name="<%= "__nombre_input_base__[__id__][_destroy]" %>" value="1">
                  </td>
                </tr>
              </script>
              <!-- ================= ESTADOS ALTERADOS ================= -->
              <h3>Estados alterados</h3>
              <%= render "personajes/form_estados_alterados",
                         listaEstadosAlterados: @x.hasEstadoalterados,
                         nombre_input_base: "has_estadoalterados",
                         table_id: "general" %>


              <!-- ================= AÑADIR PARTE CUERPO ================= -->
              <script type="text/template" id="parte-cuerpo-template">
                <%= render "form_parte_cuerpo_row", index: "__INDEX__", pc: nil %>
              </script>
              <!-- ================= PARTES CUERPO ================= -->
              <h3>Cuerpo</h3>
              <table class="tabla-estadisticas" id="parte-cuerpos-table">
                <thead>
                  <tr>
                    <th>Parte</th>
                    <th>Tipo</th>
                    <th>Salud</th>
                    <th>Mapeo</th>
                    <th>Armadura base</th>
                    <th>Modificador armadura</th>
                    <th>Estados alterados</th>
                    <th>Borrar</th>
                  </tr>
                </thead>

                <tbody id="parte-cuerpos-body">
                  <% @x.parteCuerpos.each_with_index do |pc, i| %>
                    <%= render "form_parte_cuerpo_row", index: i, pc: pc %>
                  <% end %>
                  <tr style="display:none;" id="parte-cuerpos-next"> </tr>
                </tbody>
              </table>

              <button type="button" id="add-parte-cuerpo" class="btn btn-primary">
                Añadir parte del cuerpo
              </button>

            </div>
          </section>
        </div>

        <!-- CLASES Y HABILIDADES -->
        <div id="tab-clases" class="pj-tab_pane">
          <h4>Notas</h4>
          <p> Está permitido aprender habilidades de clases que no has aprendido. </p>
          <p> Si cambias la clase de una habilidad, la habilidad aparecerá en la sección de la clase a la que has cambiado, (incluso si no has aprendido esa clase).</p>
          <p> No puedes aprender la misma habilidad varias veces (desde clases distintas), si lo haces el sistema dará un aviso y seleccionará una aleatoriamente como la buena.</p>
          <section class="columns">
            <div id="clases-section">
              <h3>Clases</h3>
              <div class="detalle_section">
                <h4>Clases aprendidas</h4>
                <% clases_ocultas = Clase.where(oculto: true).map{ |clase| clase.build_personaje_has_clase(@x) } %>
                <%= render "form_clases", phClases: clases_ocultas, destroy: "1", oculto: true %>
                <%= render "form_clases", phClases: @x.personajeHasClases, destroy: "0", oculto: false %>
              </div>
              <div class="detalle_section">
                <h4>El resto de clases</h4>
                <% remaining_clases = (Clase.order(:nombre).where(oculto: false) - @x.personajeHasClases.map(&:clase)).map{ |clase| clase.build_personaje_has_clase(@x) } %>
                <%= render "form_clases", phClases: remaining_clases, destroy: "1", oculto: false %>
              </div>
            </div>
            <div id="habilidades-section">
              <% habilidades = @x.personajeHasHabilidads_by_clase %>
              <% Clase.all.each do |clase| %>
                <%= render "form_habilidades_from_clase", clase: clase, phHabilidades: habilidades[clase.id] || [] %>
              <% end %>
            </div>
          </section>
        </div>
      
        <!-- INVENTARIO -->
        <div id="tab-items" class="pj-tab_pane">
          <h2>Oro: <%= f.number_field :oro, step: 0.01 %> </h2>
          <section class="columns">
            <div id="items-alive">
              <h3>Inventario</h3>
                <div class="carta-grid_container carta-grid_container_form_habilidad detalle_section"
                    id="items-list-alive">
                      <%  @x.personajeHasItems.each do |ph_item| %>
                        <%= render "form_item", phi: ph_item, categ_id: ct.id, destroy: "1" %>
                      <% end %>
                </div>
            </div>
            <div>
              <h3>Selecciona categoría</h3>
              <div class="miniListadoClases" id="items-menu">
                <% Categ.all.each do |ct| %>
                  <span class="carta-title" data-list="items-list-<%= ct.id %>">
                    <%= ct.nombre %></span>
                <% end %>
              </div>
              <div id="items-lists">
                <h3>Disponibles</h3>
                <% owned_items = @x.personajeHasItems %>
                <% Categ.all.each do |ct| %>
                  <div class="detalle_section pj-selected_list"
                      id="items-list-<%= ct.id %>">
                    <h4><%= ct.nombre %></h4>
                    <div class="carta-grid_container carta-grid_container_form_habilidad"
                        id="items-list-<%= ct.id %>-destroy">
                      <% ph_items = ct.items.map{|i| i.build_personaje_has_item(@x)} - (owned_items[ct.id] || []) %>
                      <% ph_items.each do |ph_item| %>
                        <%= render "form_item", phi: ph_item, categ_id: ct.id, destroy: "1" %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </section>
        </div>

      </div>
    </div>
  <% end %>
</div>
