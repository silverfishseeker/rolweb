<%= form_with model: meta_tipo do |f| %>

  <div class="field">
    <%= f.label :nombre %>
    <%= f.text_field :nombre, class: "form-control" %>
  </div>
  <br>
  <div class="field">
    <%= f.label :clave %>
    <%= f.text_field :clave, class: "form-control" %>
  </div>
  <br>
  <div>
    <%= f.label :siglas %>
    <%= f.text_field :siglas, class: "form-control" %>
  </div>
  <br>
  <div>
    <%= f.label :orden %>
    <%= f.number_field :orden, class: "form-control" %>
  </div>
  <br>
  <% if meta_tipo.respond_to?(:tipo_estadistic) %>
    <div>
      <%= f.label :pj_tipo_estadistic_id, "Estadística base" %>
      <%= f.collection_select :pj_tipo_estadistic_id,
            Pj::TipoEstadistic.order(:orden), :id, :nombre,
            { include_blank: true }, { class: "form-control" } %>
    </div>
    <br>
  <% end %>
  <div>
    <%= f.submit %>
  </div>
<% end %>
