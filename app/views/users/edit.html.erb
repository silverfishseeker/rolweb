<h1>Editar usuario</h1>

<%= form_with model: @x, local: true do |f| %>

  <div>
    <%= f.label :email %><br>
    <%= @x.email %>
  </div>

  <div>
    <%= f.label :nombre %><br>
    <%= f.text_field :nombre %>
  </div>

  <div>
    <%= f.label :rango %><br>
    <%= f.select :rango, @ranks, {}, class: "form-control" %>
  </div>

  <br>

  <%= f.submit "Guardar cambios" %>
<% end %>
