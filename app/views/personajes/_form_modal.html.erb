<%# Expected params: class_modal_type, buttom_text, header_text, index, &block %>
<%# index must contain a prefix so it is unique between different kinds of models using the modals %>

<button type="button"
        class="open-modal"
        id="btn-estados-<%=index%>"
        data-index="modal-<%=index%>">
  <%= buttom_text %>
</button>
<div id="modal-<%=index%>"
      class="pj-modal <%=class_modal_type%>">
  <header>
    <h4><%= header_text %></h4>
    <button type="button" class="btn btn-danger modal-close"
          data-index="modal-<%=index%>">
      Guardar y cerrar
    </button>
  </header>
  <div class="pj-modal_content">
    <%= yield %>
  </div>
</div>