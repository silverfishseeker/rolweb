<%# Expected params: phc, destroy %>
<div class="carta carta_form carta_form_clase" id="clase_<%= phc.clase.id %>">
  <input type="hidden" name="phcs[<%= phc.clase.id %>][_destroy]" value="<%= destroy %>">
  <input type="hidden" name="phcs[<%= phc.clase.id %>][clase_id]" value="<%= phc.clase.id %>">
  <div>
    <div class="carta-header">
      <input type="number" name="phcs[<%= phc.clase.id %>][nivel]" value="<%= phc.nivel %>" class="carta-number carta-level carta-level_clase">
      <%= link_to phc.clase.nombre, phc.clase, class:"carta-title carta-title_clase" %>
      <div class="carta-image carta-image_icon">
        <%= render "shared/image", image: phc.clase.image %>
      </div>
      <div class="carta-add_buttom" data-clase-id="<%= phc.clase.id %>">
        <%= destroy == "1" ? "+" : "-" %>
      </div>
    </div>
    <%= clase_subtitulo(phc.clase) %>
    <div class="carta-description carta-description_form">
      <%= phc.clase.efecto %>
      <%= phc.sobreescritura ? phc.sobreescritura : phc.clase.efecto %>
    </div>
  </div>
</div>
