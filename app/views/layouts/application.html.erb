<!DOCTYPE html>
<html>
  <head>
    <title>Varacia</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="google-site-verification" content="vBzitV_gqrvlj-fq7lXP_3VrUQ3XnNW2QhR4wrTBDCQ" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", media: 'all', "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :page_js %>
  </head>

  <body <%= content_for?(:body_class) ? "class=#{yield(:body_class)}" : '' %>>
     
    <nav class="navbar">
      <h1><%= link_to "Varacia", root_path %></h1>
      <div class="subnavbar">
        
        <% only_admin_content do %>
          <div class="submenu">
            <a href="/control" class="nblink">Admin</a>
            <div class="submenu-content">
              <%= link_to "Panel de control", "/control" %>
              <%= link_to "Backup", "/backup" %>
              <%= link_to "+enemigo", new_mob_path %>
              <%= link_to "+clase", new_clase_path %>
              <%= link_to "+habilidad", new_habilidad_path %>
              <%= link_to "+item", new_item_path %>
              <%= link_to "+cuadro", new_picture_path %>
              <%= link_to "+etiqueta", new_etiquet_path %>
              <%= link_to "+cuento", new_cuento_path %>
            </div>
          </div>
        <% end %>

        <div class="submenu">
          <a href="/reglas" class="nblink">Información</a>
          <div class="submenu-content">
              <a href="/reglas">Reglas</a>
              <a href="/estadosAlterados">Estados Alterados</a>
              <a href="/newPlayersHelp">Ayuda para nuevos jugadores</a>
              <%= link_to "Historias y trasfondo", main_cuento_path%>
          </div>
        </div>

        <div class="submenu">
          <%= link_to "Clases y habilidades", clases_path, class:"nblink" %>
          <div class="submenu-content">
            <%= link_to "Todas las clases", clases_path, class:"mainLink" %>
            <%= link_to "Todas las habilidades", habilidads_path, class:"mainLink" %>
            <%= link_to "Árbol de clases", "/clases-arbol", class:"mainLink" %>
            <%= link_to "Clases radicales", clases_path(mode:"radical"), class:"mainLink" %>
            <%= link_to "Razas", clases_path(mode:"raza"), class:"mainLink" %>
            <% navbar_cache_clases_ocultas.each do |clase| %>
                <%= link_to clase.nombre, clase, class:"mainLink"  %>
            <% end %>
            <% navbar_cache_clases_visibles.each do |clase| %>
                <%= link_to clase.nombre, clase %>
            <% end %>
          </div>
        </div>

        <div class="submenu">
          <%= link_to "Items", items_path, class:"nblink" %>
          <div class="submenu-content">
            <%= link_to "Todos los items", items_path, class:"mainLink" %>
            <%= link_to "Cofre aleatorio", "/lootbox", class:"mainLink" %>
            <% navbar_cache_categorias.each do |ct| %>
                <%= link_to ct.nombre, ct %>
            <% end %>
          </div>
        </div>

        <div class="submenu">
          <%= link_to "Personajes", personajes_path, class:"nblink #{"nblink_notSubMenu" unless user_signed_in?}" %>
          <% if user_signed_in? %>
            <div class="submenu-content">
              <% current_user.personajes.each do |pj|%>
                <%= link_to pj.nombre, pj %>
              <% end %>
              <%= link_to "Nuevo", new_personaje_path, class:"mainLink" %>
              <%= link_to "Mis personajes", personajes_path(mode:"privados"), class:"mainLink" %>
              <%= link_to "Todos los personajes", personajes_path, class:"mainLink" %>
              <% if controller.has_level?(:master) %>
                <% current_user.personajegroups.each do |pg| %>
                  <%= link_to pg.nombre, pg %>
                <% end %>
                <%= link_to "Nuevo grupo de personajes", new_personajegroup_path, class:"mainLink" %>
                <%#= link_to "Mis grupos de personajes", personajegroups_path, class:"mainLink" %>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if controller.has_level?(:master) %>
          <div class="submenu">
            <%= link_to "Enemigos y seres", mobs_path, class:"nblink nblink_notSubMenu" %>
          </div>
        <% end %>
        
        <div class="submenu">
          <%= link_to "Galería", pictures_path, class:"nblink nblink_notSubMenu" %>
        </div>

        <div class="submenu auth-submenu">
          <% if user_signed_in? %>
            <a href="<%=dashboard_profile_path%>" class="nblink">
              <%= render "shared/icon", user: current_user %>
              <%= current_user.nombre%>
            </a>
            <div class="submenu-content auth-submenu-content" style="padding: 0;">
              <%= link_to 'Mi cuenta', dashboard_profile_path %>
              <%= link_to 'Cerrar sesión', destroy_user_session_path %>
            </div>
          <% else %>
            <a class="nblink">Cuenta</a>
            <div class="submenu-content auth-submenu-content">
              <div class="auth-section">
                <h3>Iniciar sesión</h3>
                <%= form_with url: user_session_path, method: :post, local: true, scope: :user, class: "auth-form" do |f| %>
                  <div>
                    <%= f.label :email %>
                    <%= f.email_field :email, required: true, class: "text" %>
                  </div>
                  <div>
                    <%= f.label :password, "Contraseña" %>
                    <%= f.password_field :password, required: true, class: "text" %>
                  </div>
                  <div class="remember-me">
                    <%= f.check_box :remember_me, { checked: true } %>
                    <%= f.label :remember_me, "Recuérdame" %>
                  </div>
                  <%= f.submit "Entrar", class: "auth-btn" %>
                <% end %>
              </div>
              <div class="auth-section">
                <%= link_to "Crear cuenta", new_user_registration_path, class: "auth-btn" %>
              </div>
            </div>
          <% end %>
        </div>

        <%= image_tag "scroll.png", class:"subnavbar-scroll_indicator"%>
      </div>
    </nav>

    <% # Divs para mostrar mensajes y alerta del sistema relacionados con el resultado de procesos %>
    <div class="flash-wrapper">
      <% if notice %>
        <div class="flash-notice">
          <span class="flash-close" onclick="this.parentElement.remove()">✕</span>
          <%= notice %>
        </div>
      <% end %>
      <% if alert%>
        <div class="flash-alert">
          <span class="flash-close" onclick="this.parentElement.remove()">✕</span>
          <%= alert %>
        </div>
      <% end %>
      <% if flash[:warning]%>
        <div class="flash-warning">
          <span class="flash-close" onclick="this.parentElement.remove()">✕</span>
          <%= flash[:warning] %>
        </div>
      <% end %>
    </div>


    <div class="main-content <%= content_for?(:main_content_class) ? yield(:main_content_class) : '' %>">
      <%= yield %>
    </div>

    
    <footer class="footbar">
      <div> <%# Este div no sobra.%> </div>
      <div>
        <%= link_to "Información legal", "/avisolegal"%>
      </div>
      <div>
        <div class="footbar-admin_button">
          <% if session[:admin] %>
            <%= link_to "Cerrar sesión", "/adminsession/close" %>
          <% end %>
        </div>
      </div>
    </footer>

  </body>
</html>
